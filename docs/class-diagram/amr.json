  "cards": [
    {
      "dot": "cyan",
      "title": "Free preparation functions",
      "items": [
        "lbm::amr::prepare_static_hierarchy(spec, profile, boundaries) -> StaticHierarchyPreparation<...>",
        "lbm::amr::prepare_dynamic_hierarchy(spec, profile, tagging, boundaries) -> HierarchyPreparation<...>",
        "HierarchyPreparation::take() transfers unique ownership of LbmAmrSimulation.",
        "lbm::runtime::prepare_amr_evolution(simulation, intent, selection) -> LbmAmrEvolutionPreparation<...>; take() yields PreparedAmrEvolution."
      ]
    },
    {
      "dot": "emerald",
      "title": "Lifetime and sequencing",
      "items": [
        "The simulation owns fields, boundaries and coarse/fine coupling. PreparedAmrEvolution is borrowed, not owned by the simulation.",
        "LbmAmrView owns a vector of small level-view records; those records borrow field references. It does not own another copy of the fields.",
        "Fine levels subcycle twice. Dynamic regridding is conditional on the synchronized interval; static tagging does not regrid.",
        "Collect interval forces before regridding; remap populations and rebuild affected coupling/boundary records after layout changes."
      ]
    },
    {
      "dot": "amber",
      "title": "Notation and limits",
      "items": [
        "D = Descriptor, P = initialization profile, T = tagging type, C = collision operator.",
        "Selected signatures abbreviate parameters and template arguments; overloads, qualifiers and many helper types are omitted.",
        "AI-generated with Archify; see sources.md and known limitations. Dynamic AMR remains experimental."
      ]
    }
