# Case-owned DFG-derived Re20 D3Q27/YMS N_D=20,nz=4 command identity.
# Re_D=20 is represented by the channel-height closure Re_H=82.

channel_cylinder.variant = re20_yms
channel_cylinder.diameter_intervals = 20
channel_cylinder.depth_cells = 4
channel_cylinder.rho_lb = 1.0
channel_cylinder.u_mean_lb = 0.035
channel_cylinder.u_mean_phys = 0.2
channel_cylinder.reynolds_height = 82

mesh.max_grid_size = 64

run.max_step = 60000
run.final_time_phys = 52.5
run.kind = validation
run.variant = d3q27_re20_yms_nd20_nz4

diagnostics.interval = 1000
diagnostics.steady_check_interval = 100
diagnostics.steady_l2_tolerance = 5.0e-7
diagnostics.stop_on_steady = 0

channel_cylinder_observation.force_interval = 1
channel_cylinder_observation.output_interval = 100
channel_cylinder_observation.write_history = 1
channel_cylinder_observation.assert = 1

output.directory = showcases/channel_cylinder/outputs
output.log_directory = showcases/channel_cylinder/log
output.plot_interval = 0
output.write_final_plotfile = 1
