# Case-owned DFG-derived Re100 D2Q9/YMS N_D=80 command identity.
# Re_D=100 is represented by the channel-height closure Re_H=410.

channel_cylinder.variant = re100_yms
channel_cylinder.diameter_intervals = 80
channel_cylinder.depth_cells = 1
channel_cylinder.rho_lb = 1.0
channel_cylinder.u_mean_lb = 0.035
channel_cylinder.u_mean_phys = 1.0
channel_cylinder.reynolds_height = 410

mesh.max_grid_size = 128

run.max_step = 800000
run.final_time_phys = 35.0
run.kind = validation
run.variant = d2q9_re100_yms_nd80

diagnostics.interval = 10000
diagnostics.steady_check_interval = 0
diagnostics.steady_l2_tolerance = 5.0e-7
diagnostics.stop_on_steady = 0

channel_cylinder_observation.force_interval = 1
channel_cylinder_observation.output_interval = 400
channel_cylinder_observation.write_history = 1
channel_cylinder_observation.assert = 0

output.directory = showcases/channel_cylinder/outputs
output.log_directory = showcases/channel_cylinder/log
output.plot_interval = 0
output.write_final_plotfile = 1
