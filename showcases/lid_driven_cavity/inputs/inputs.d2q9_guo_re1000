# Canonical D2Q9/BGK/Guo lid-driven cavity, Re=1000.
#
# C++ owns Descriptor, Dynamics, rest initialization, the four Guo physical
# boundary records, 129-node/128-interval geometry derivation, reference policy
# and artifact schema. This file configures only stable case/run controls.

cavity.physical_lo = 0.0 0.0
cavity.physical_hi = 1.0 1.0
cavity.intervals = 128 128
cavity.depth_cells = 1
cavity.wall_scheme = guo_extrapolation
cavity.rho_lb = 1.0
cavity.re = 1000.0
cavity.lid_velocity_lb = 0.1
cavity.u_ref_phys = 1.0

mesh.max_grid_size = 32

run.max_step = 400000
run.final_time_phys = 1.0
run.kind = validation
run.variant = d2q9_guo_re1000_ghia

diagnostics.interval = 5000
diagnostics.steady_check_interval = 5000
diagnostics.steady_l2_tolerance = 5.0e-8
diagnostics.stop_on_steady = 1
diagnostics.write_centerlines = 1
diagnostics.write_metrics = 1

output.directory = showcases/lid_driven_cavity/outputs/d2q9_guo_re1000_ghia
output.log_directory = showcases/lid_driven_cavity/log
output.plot_interval = 400000
output.write_final_plotfile = 1
