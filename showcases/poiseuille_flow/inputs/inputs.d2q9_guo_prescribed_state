# Guo prescribed state supplies rho plus the complete Poiseuille velocity
# profile on xlo/xhi; it is a diagnostic full-macroscopic Dirichlet variant.
poiseuille_flow.variant = guo_prescribed_state
poiseuille_flow.intervals = 40 10
poiseuille_flow.depth_cells = 1
poiseuille_flow.rho_lb = 1.0
poiseuille_flow.u_max_lb = 0.1
poiseuille_flow.u_ref_phys = 1.0
poiseuille_flow.tau = 0.75
poiseuille_flow.rho_in_lb = 1.04
poiseuille_flow.rho_out_lb = 0.96
poiseuille_flow.pressure_scaling = fixed_re_fixed_tau

mesh.max_grid_size = 16
run.max_step = 20000
run.final_time_phys = 1.0
run.kind = experiment
run.variant = d2q9_guo_prescribed_state_poiseuille_N10

diagnostics.interval = 100
diagnostics.steady_check_interval = 100
diagnostics.steady_l2_tolerance = 5.0e-8
diagnostics.stop_on_steady = 1

poiseuille_validation.write_profile = 1
poiseuille_validation.assert = 0
poiseuille_validation.mass_assert = 0
poiseuille_validation.e2_profile_tolerance = 2.0e-1
poiseuille_validation.einf_profile_tolerance = 2.0e-1
poiseuille_validation.transverse_tolerance = 2.0e-2
poiseuille_validation.mass_tolerance = 1.0e-5
poiseuille_validation.pressure_boundary_rho_tolerance = 1.0e-10

output.directory = showcases/poiseuille_flow/outputs
output.log_directory = showcases/poiseuille_flow/log
output.plot_interval = 20000
output.write_final_plotfile = 1
